
@{
    ViewData["Title"] = "Contact & About";
}

<section class="contact-page">
    <h1 class="contact-heading">Contact & About</h1>

    <div class="container-fluid">
        <div class="row g-4 contact-grid">

            <!-- CONTACT US -->
            <div class="col-12 col-md-4">
                <div class="contact-card">
                    <h2>Contact Us</h2>

                    <p>
                        Welcome to ArtifyAI, a website
                        exploring artificial intelligence
                        in creative arts.
                    </p>

                    <p>
                        Developed for the Web Design and
                        Programming assessment at the
                        University of Canberra.
                    </p>

                    <p>
                        Email:
                        <a href="mailto:your-email@example.com">
                            Contact Developer
                        </a>
                    </p>
                </div>
            </div>

            <!-- ABOUT US -->
            <div class="col-12 col-md-4">
                <div class="contact-card">
                    <h2>About Us</h2>

                    <p>
                        ArtifyAI explores how artificial
                        intelligence is changing digital art,
                        music composition, and creative writing.
                    </p>

                    <p>
                        Our goal is to introduce innovative
                        AI tools and demonstrate how technology
                        can support human creativity.
                    </p>

                    <p>
                        Built with ASP.NET Core MVC, C#,
                        HTML5, Bootstrap 5, CSS3,
                        and JavaScript.
                    </p>
                </div>
            </div>

            <!-- COPYRIGHT -->
            <div class="col-12 col-md-4">
                <div class="contact-card">
                    <h2>Copyright & Sources</h2>

                    <p>
                        Website images were generated using
                        OpenAI's image generation tool.
                    </p>

                    <p>
                        Framework:
                        <a href="https://getbootstrap.com/">
                            Bootstrap 5
                        </a>
                    </p>

                    <p>
                        AI tools referenced:
                        <a href="https://www.adobe.com/products/firefly.html">
                            Adobe Firefly
                        </a>,
                        <a href="https://suno.com/">Suno</a>,
                        <a href="https://www.aiva.ai/">AIVA</a>,
                        <a href="https://www.grammarly.com/">Grammarly</a>,
                        <a href="https://www.sudowrite.com/">Sudowrite</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
