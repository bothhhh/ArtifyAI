@model ArtifyAI.Models.AIImage

@{
    ViewData["Title"] = "Edit AI Image";
}

<section class="ai-gallery">
    <div class="container">

        <div class="gallery-heading">
            <h1>Edit AI Image</h1>
            <p>Update the information about this artwork.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-7">

                <div class="gallery-card">

                    <img class="details-image"
                         src="@Url.Content("~/images/" + Model.Filename)"
                         alt="@Model.Prompt" />

                    <div class="gallery-content">

                        <form asp-controller="AIImages"
                              asp-action="Edit"
                              asp-route-id="@Model.Id"
                              method="post"
                              enctype="multipart/form-data">

                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="Id" />

                            <div class="mb-3">
                                <label asp-for="Prompt"
                                       class="form-label"></label>

                                <textarea asp-for="Prompt"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="Prompt"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ImageGenerator"
                                       class="form-label"></label>

                                <input asp-for="ImageGenerator"
                                       class="form-control" />

                                <span asp-validation-for="ImageGenerator"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label for="imageFile" class="form-label">
                                    Replace Image (Optional)
                                </label>

                                <input type="file"
                                    id="imageFile"
                                    name="imageFile"
                                    class="form-control"
                                    accept=".jpg,.jpeg,.png,.webp" />

                                <span class="text-danger"
                                    asp-validation-for="Filename"></span>

                                <small class="text-muted">
                                    Leave this empty to keep the current image.
                                    Maximum file size: 5 MB.
                                </small>
                            </div>

                            <button type="submit" class="btn btn-primary">Save Changes</button>

                            <a asp-action="Details"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}