
@model IEnumerable<ArtifyAI.Models.AIImage>

@{
    ViewData["Title"] = "AI Image Gallery";
}

<section class="ai-gallery">

    <div class="gallery-heading">
        <h1>AI Image Gallery</h1>

        <p>Explore creative artwork generated using AI.</p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="AIImages"
               asp-action="Create"
               class="btn btn-primary">
                Upload AI Image
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-center">
            No AI images have been uploaded yet.
        </p>
    }
    else
    {
        <div class="gallery-grid">

            @foreach (var image in Model)
            {
                <div class="gallery-card">

                    <img class="gallery-image"
                         src="@Url.Content("~/images/" + image.Filename)"
                         alt="@image.Prompt" />

                    <div class="gallery-content">

                        <h5>@image.ImageGenerator</h5>

                        <p>@image.Prompt</p>

                        <p>Likes: @image.Likes</p>

                        <a asp-action="Details"
                           asp-route-id="@image.Id"
                           class="btn btn-outline-primary">
                            View Details
                        </a>

                    </div>
                </div>
            }

        </div>
    }

</section>