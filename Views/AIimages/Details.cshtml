@model ArtifyAI.Models.AIImage

@{
    ViewData["Title"] = "AI Image Details";
}

<section class="ai-gallery">
    <div class="container">

        <div class="gallery-heading">
            <h1>AI Image Details</h1>
            <p>Explore the story behind this AI-generated artwork.</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="gallery-card">

                    <img src="@Url.Content("~/images/" + Model.Filename)"
                         class="details-image"
                         alt="@Model.Prompt" />

                    <div class="gallery-content">

                        <h2>@Model.ImageGenerator</h2>

                        <h5>AI Prompt</h5>
                        <p>@Model.Prompt</p>

                        <h5>Upload Date</h5>
                        <p>@Model.UploadDate.ToString("dd MMMM yyyy")</p>

                        <h5>Likes</h5>
                        <p class="ai-like-count">
                            Likes: <span>@Model.Likes</span>
                        </p>
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="AIImages"
                                asp-action="Like"
                                asp-route-id="@Model.Id"
                                method="post"
                                class="mt-3">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-primary">
                                    ❤️ Like
                                </button>

                                <input type="hidden" name="returnToDetails" value="true" />
                            </form>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                            asp-route-id="@Model.Id"
                            class="btn btn-warning">
                                Edit
                            </a>

                            <a asp-action="Delete"
                            asp-route-id="@Model.Id"
                            class="btn btn-danger">
                                Delete
                            </a>
                        }

                        <a asp-controller="AIImages"
                        asp-action="Index"
                        class="btn btn-secondary">
                            Return to Gallery
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>